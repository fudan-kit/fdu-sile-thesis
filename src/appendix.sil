\begin{fdu:appendix}

\fdu:appendix-section{命令速查}

\begin{itemize}
\item{题名与作者： \fdu:code{fdu:title}、 \fdu:code{fdu:titleEn}、 \fdu:code{fdu:author}、 \fdu:code{fdu:studentId}。}
\item{培养信息： \fdu:code{fdu:supervisor}、 \fdu:code{fdu:department}、 \fdu:code{fdu:major}、 \fdu:code{fdu:date}、 \fdu:code{fdu:clc}。}
\item{摘要关键词： \fdu:code{fdu:keywordsCn}、 \fdu:code{fdu:keywordsEn}。}
\item{论文结构： \fdu:code{fdu:makecover}、 \fdu:code{fdu:frontmatter}、 \fdu:code{fdu:mainmatter}、 \fdu:code{fdu:backmatter}、 \fdu:code{fdu:declaration}。}
\item{图表清单： \fdu:code{fdu:figure}、 \fdu:code{fdu:table-caption}、 \fdu:code{fdu:listoffigures}、 \fdu:code{fdu:listoftables}。}
\item{字体辅助： \fdu:code{fdu:songti}、 \fdu:code{fdu:heiti}、 \fdu:code{fdu:kaiti}、 \fdu:code{fdu:fangsong}、 \fdu:code{fdu:bold}、 \fdu:code{fdu:italic}、 \fdu:code{fdu:code}。}
\end{itemize}

\fdu:appendix-section{最小编译流程}

从干净状态重新生成论文可执行：

\begin[type=verbatim]{raw}
make clean
make
pdfinfo paper.pdf
pdffonts paper.pdf
\end{raw}

若目录或图表清单导致页数继续变化，可再运行一次 sile paper.sil。正式打印前应逐页查看渲染结果，而不是只依赖文本抽取或自动检查。

\end{fdu:appendix}
\end{document}
